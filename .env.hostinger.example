APP_NAME=BikeWorld
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger MySQL — create DB in hPanel → Databases → MySQL Databases
# Host is usually localhost (or the host shown in hPanel)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_bikeworld
DB_USERNAME=u123456789_bwuser
DB_PASSWORD=YOUR_MYSQL_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

SHIPMENT_SYNC_SCHEDULER=true
SHIPMENT_SYNC_STALE_MINUTES=30
SHIPMENT_SYNC_CHUNK_SIZE=50

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="bikeworld707@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_QUEUE_NOTIFICATIONS=true

# Brevo
BREVO_ENABLED=true
BREVO_TRANSPORT=api
BREVO_API_KEY=
BREVO_SENDER_EMAIL="${MAIL_FROM_ADDRESS}"
BREVO_SENDER_NAME="${MAIL_FROM_NAME}"
BREVO_TIMEOUT=30
BREVO_MAX_RETRIES=3
BREVO_SMS_ENABLED=false
BREVO_WHATSAPP_ENABLED=false

STORE_SUPPORT_EMAIL=bikeworld707@gmail.com
STORE_SUPPORT_PHONE=9743663260

# Delhivery
DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_MOCK=false
DELHIVERY_CLIENT_NAME=
DELHIVERY_PICKUP_LOCATION="BikeWorld Warehouse"
DELHIVERY_PICKUP_ADDRESS=
DELHIVERY_PICKUP_CITY=
DELHIVERY_PICKUP_STATE=
DELHIVERY_PICKUP_PIN=
DELHIVERY_PICKUP_PHONE=9743663260

VITE_APP_NAME="${APP_NAME}"

SEO_SITE_NAME=BikeWorld
SEO_DEFAULT_TITLE="BikeWorld — Buy Bike Accessories, Helmets & Riding Gear Online India"
SEO_DEFAULT_DESCRIPTION="Shop premium bike accessories, helmets, gloves, riding jackets & motorcycle gear at BikeWorld. Genuine products, pan-India delivery, COD & easy returns."
SEO_DEFAULT_KEYWORDS="bike accessories online india, motorcycle accessories, buy bike gear online, helmet online india, riding gloves, riding jacket, bike parts online, motorcycle helmet, bike care products, Royal Enfield accessories, KTM accessories, Bajaj Pulsar accessories, bike chain lube, COD bike accessories, pan india bike delivery, BikeWorld, BikeWorld India"
SEO_OG_IMAGE=/images/logo.png
SEO_LOCALE=en_IN
SEO_ROBOTS=index,follow

# Razorpay — use live keys only with HTTPS
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK=false
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME="${APP_NAME}"
