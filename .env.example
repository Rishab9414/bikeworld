APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Background jobs (run: php artisan queue:work --queue=default,deliveries,notifications)
SHIPMENT_SYNC_SCHEDULER=true
SHIPMENT_SYNC_STALE_MINUTES=30
SHIPMENT_SYNC_CHUNK_SIZE=50

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bikeworld707@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_QUEUE_NOTIFICATIONS=true

# Brevo — Email, SMS & WhatsApp (https://developers.brevo.com/guides/php)
# Dashboard: https://app.brevo.com → SMTP & API
BREVO_ENABLED=false
BREVO_TRANSPORT=api
# API key (Dashboard → SMTP & API → API Keys) — used for email (api mode), SMS & WhatsApp
BREVO_API_KEY=
BREVO_SENDER_EMAIL="${MAIL_FROM_ADDRESS}"
BREVO_SENDER_NAME="${MAIL_FROM_NAME}"
BREVO_TIMEOUT=30
BREVO_MAX_RETRIES=3
# SMTP fallback (only if BREVO_TRANSPORT=smtp) — Dashboard → SMTP & API → SMTP keys
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
BREVO_SMTP_ENCRYPTION=tls
# Optional SMS / WhatsApp (also uses BREVO_API_KEY)
BREVO_SMS_ENABLED=false
BREVO_WHATSAPP_ENABLED=false
BREVO_SMS_SENDER="${APP_NAME}"

# Store Contact (footer, policy pages, emails)
STORE_SUPPORT_EMAIL=bikeworld707@gmail.com
STORE_SUPPORT_PHONE=9743663260

# Delhivery Shipping
DELHIVERY_PICKUP_PHONE=9743663260

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SEO (Search Engine Optimization)
SEO_SITE_NAME="${APP_NAME}"
SEO_DEFAULT_TITLE="BikeWorld — Buy Bike Accessories, Helmets & Riding Gear Online India"
SEO_DEFAULT_DESCRIPTION="Shop premium bike accessories, helmets, gloves, riding jackets & motorcycle gear at BikeWorld. Genuine products, pan-India delivery, COD & easy returns."
SEO_DEFAULT_KEYWORDS="bike accessories online india, motorcycle accessories, buy bike gear online, helmet online india, riding gloves, riding jacket, bike parts online, motorcycle helmet, bike care products, Royal Enfield accessories, KTM accessories, Bajaj Pulsar accessories, bike chain lube, COD bike accessories, pan india bike delivery, BikeWorld, BikeWorld India"
SEO_OG_IMAGE=/images/logo.png
SEO_LOCALE=en_IN
SEO_ROBOTS=index,follow
# SEO_TWITTER_HANDLE=
# SEO_GOOGLE_SITE_VERIFICATION=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK=true
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME="${APP_NAME}"
